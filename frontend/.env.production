# Production API base URL — must include /api/v1 (same as local api.js BASE_URL).
# AWS Amplify: App settings → Environment variables → add VITE_API_URL, then redeploy.
# SAM HTTP API example (no /prod stage unless your stack uses one):
# VITE_API_URL=https://xxxxxxxx.execute-api.ap-south-1.amazonaws.com/api/v1
VITE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/api/v1

# Google OAuth
VITE_GOOGLE_CLIENT_ID=1037832084603-1urot8c52r4psifqui2rp4udisvqmt1r.apps.googleusercontent.com
