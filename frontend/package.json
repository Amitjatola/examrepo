{
    "name": "aerogate-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "preview": "vite preview",
        "start": "serve dist -s -l ${PORT:-3000}",
        "test:e2e": "playwright test --project=chromium",
        "test:e2e:all-browsers": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:bugs": "node scripts/generate-e2e-bug-report.mjs",
        "test:e2e:firefox": "playwright test --project=firefox",
        "test:e2e:full": "playwright test && node scripts/generate-e2e-bug-report.mjs"
    },
    "dependencies": {
        "@react-oauth/google": "^0.13.4",
        "clsx": "^2.1.1",
        "framer-motion": "^12.23.26",
        "katex": "^0.16.11",
        "lucide-react": "^0.469.0",
        "mathjs": "^15.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "recharts": "^3.6.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "serve": "^14.2.0",
        "tailwind-merge": "^2.5.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.23",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "vite": "^6.0.0",
        "vitest": "^4.1.5"
    }
}
